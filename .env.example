# Google Gemini API key. Get one at https://aistudio.google.com/apikey
# Never commit the real value — this file only documents the shape.
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use. Must support response_mime_type=application/json + response_schema.
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated list of origins allowed to call this API.
# Set this to your GitHub Pages demo URL, e.g. https://your-username.github.io
ALLOWED_ORIGINS=http://localhost:5173

# Maximum accepted PDF upload size, in megabytes.
MAX_FILE_SIZE_MB=10

# Rate limit per client IP, slowapi format (see https://slowapi.readthedocs.io).
RATE_LIMIT=10/minute
